generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String            @id @default(cuid())
  email              String            @unique
  password           String
  createdAt          DateTime          @default(now())
  plan               String            @default("FREE")
  subscriptionStatus String?
  stripeCustomerId   String?
  resetToken         String?
  resetTokenExpiry   DateTime?
  role               String            @default("USER")
  accounts           Account[]
  activities         Activity[]
  analytics          Analytics?
  leads              Lead[]
  nfcCards           NfcCard[]
  profile            Profile?
  businessProfiles   BusinessProfile[]
  sessions           Session[]
}

model Profile {
  id        String   @id @default(cuid())
  fullName  String
  company   String?
  jobTitle  String?
  phone     String?
  website   String?
  bio       String?
  username  String   @unique
  createdAt DateTime @default(now())
  userId    String   @unique
  image     String?
  linkedin  String?
  github    String?
  twitter   String?
  instagram String?
  youtube   String?
  whatsapp  String?
  user      User     @relation(fields: [userId], references: [id])
}

model Analytics {
  id           String   @id @default(cuid())
  profileViews Int      @default(0)
  qrScans      Int      @default(0)
  nfcTaps      Int      @default(0)
  leads        Int      @default(0)
  userId       String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model PlanLimit {
  plan_name       String   @id
  max_profiles    Int?
  max_qr_codes    Int?
  max_leads       Int?
  analytics_level String?
  nfc_enabled     Boolean?
  team_enabled    Boolean?
  company_enabled Boolean?
  api_enabled     Boolean?
  display_name    String?
  monthly_price   Decimal? @db.Decimal(10, 2)
  yearly_price    Decimal? @db.Decimal(10, 2)
  active          Boolean? @default(true)
  display_order   Int?     @default(0)
  description     String?

  @@map("plan_limits")
}

model Lead {
  id String @id @default(cuid())

  // Existing User Relation (KEEP)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // New Professional Profile Relation
  businessProfileId String?
  businessProfile BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  name String

  company String?

  email String?

  phone String?

  message String?

  status LeadStatus @default(NEW)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Activity {
  id        String   @id @default(cuid())
  type      String
  message   String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NfcCard {
  id                  String    @id @default(cuid())
  token               String    @unique
  status              String    @default("ACTIVE")
  type                String    @default("BASIC")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  lastUsedAt          DateTime?
  expiresAt           DateTime?
  userId              String
  plan                String    @default("FREE")
  billingCycle        String    @default("MONTHLY")
  lifetimeAccess      Boolean   @default(false)
  trialEndsAt         DateTime?
  lemonCustomerId     String?
  lemonOrderId        String?
  lemonSubscriptionId String?
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Coupon {
  id           String    @id @default(cuid())
  code         String    @unique
  type         String
  value        Float
  active       Boolean   @default(true)
  usageLimit   Int?
  usedCount    Int       @default(0)
  expiresAt    DateTime?
  allowedPlans String?
  description  String?
  createdAt    DateTime  @default(now())
}

model BusinessProfile {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  slug String @unique

  firstName  String
  middleName String?
  lastName   String

  companyName String
  displayName String?

  jobTitle String

  primaryPhone   String
  secondaryPhone String?
  officePhone    String?
  extension      String?

  email   String
  website String?

  address String?

  city    String
  country String

  aboutMe String?

  profileImage    String?
  companyLogo     String?
  backgroundImage String?
  templateId String @default("professional-corporate")
  linkedin      String?
  github        String?
  instagram     String?
  youtube       String?
  whatsapp      String?
  twitter       String?
  facebook      String?
  pinterest     String?
  bluesky       String?
  snapchat      String?
  googleReviews String?
  blogger       String?

  active Boolean @default(true)

  profileViews Int @default(0)

  isPublished Boolean @default(false)
  leads Lead[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Plan {
  FREE
  STARTER
  PRO
  PREMIUM
}

enum CardStatus {
  ACTIVE
  INACTIVE
}
