"use client";

import { useEffect, useState } from "react";
import { useSession } from "next-auth/react";

type AgentStatus = {
  success: boolean;
  version?: string;
  status?: string;
  reader_connected?: boolean;
  reader?: string | null;
};

type NfcReadResult = {
  success: boolean;
  reader_connected?: boolean;
  reader?: string | null;
  card_present?: boolean;
  uid?: string | null;
  message?: string;
};

type NfcWriteResult = {
  success: boolean;
  card_present?: boolean;
  uid?: string | null;
  url?: string;
  written_pages?: number[];
  message?: string;
};

export default function NFCPage() {
  const { data: session } = useSession();

  // ---------------------------------------------------------
  // Web NFC
  // ---------------------------------------------------------

  const [webNfcSupported, setWebNfcSupported] =
    useState(false);

  // ---------------------------------------------------------
  // Local Agent
  // ---------------------------------------------------------

  const [agentStatus, setAgentStatus] =
    useState<AgentStatus | null>(null);

  const [checkingAgent, setCheckingAgent] =
    useState(false);

  // ---------------------------------------------------------
  // Card
  // ---------------------------------------------------------

  const [profileUrl, setProfileUrl] =
    useState("");

  const [writing, setWriting] =
    useState(false);

  const [message, setMessage] =
    useState("");

  // ---------------------------------------------------------
  // Detect Web NFC
  // ---------------------------------------------------------

  useEffect(() => {
    if ("NDEFReader" in window) {
      setWebNfcSupported(true);
    }
  }, []);

  // ---------------------------------------------------------
  // Get / create user's NFC card
  // ---------------------------------------------------------

  useEffect(() => {
    const setupNfcCard = async () => {
      if (!session?.user?.email) return;

      try {
        const response =
          await fetch("/api/test-nfc", {
            cache: "no-store",
          });

        const data =
          await response.json();

        if (
          response.ok &&
          data?.success &&
          data?.card?.token
        ) {
          /*
           * IMPORTANT:
           *
           * Always use the real production iLinq.Team
           * domain for the NFC URL.
           *
           * Do not use localhost here.
           */

          setProfileUrl(
            `https://ilinq.team/card/${data.card.token}`
          );
        }
      } catch (error) {
        console.error(
          "NFC card setup error:",
          error
        );

        setMessage(
          "❌ Unable to load NFC card information."
        );
      }
    };

    setupNfcCard();
  }, [session]);

  // ---------------------------------------------------------
  // Check Local Agent
  // ---------------------------------------------------------

  const checkLocalAgent = async () => {
    setCheckingAgent(true);

    try {
      const response =
        await fetch(
          "http://127.0.0.1:8765/status",
          {
            method: "GET",
            cache: "no-store",
          }
        );

      if (!response.ok) {
        throw new Error(
          "NFC Local Agent is not responding."
        );
      }

      const data =
        await response.json();

      setAgentStatus(data);

    } catch (error) {

      console.error(
        "NFC Local Agent error:",
        error
      );

      setAgentStatus({
        success: false,
        status: "offline",
        reader_connected: false,
        reader: null,
      });

    } finally {
      setCheckingAgent(false);
    }
  };

  // ---------------------------------------------------------
  // Automatically check Local Agent
  // ---------------------------------------------------------

  useEffect(() => {
    checkLocalAgent();
  }, []);

  // ---------------------------------------------------------
  // Write using Windows ACR122U Local Agent
  // ---------------------------------------------------------

  const writeWithLocalAgent = async () => {

    if (!profileUrl) {
      setMessage(
        "❌ NFC URL is not ready yet."
      );
      return;
    }

    setWriting(true);
    setMessage("");

    try {

      /*
       * First check that the Local Agent is available.
       */

      const statusResponse =
        await fetch(
          "http://127.0.0.1:8765/status",
          {
            method: "GET",
            cache: "no-store",
          }
        );

      if (!statusResponse.ok) {
        throw new Error(
          "NFC Local Agent is not available."
        );
      }

      const status =
        await statusResponse.json();

      if (!status.reader_connected) {
        throw new Error(
          "ACR122U NFC reader was not detected."
        );
      }

      /*
       * Write the real iLinq.Team card URL.
       */

      const response =
        await fetch(
          "http://127.0.0.1:8765/nfc/write",
          {
            method: "POST",
            headers: {
              "Content-Type":
                "application/json",
            },
            body: JSON.stringify({
              url: profileUrl,
            }),
          }
        );

      const data: NfcWriteResult =
        await response.json();

      if (!data.success) {
        throw new Error(
          data.message ||
            "NFC card write failed."
        );
      }

      setMessage(
        `✅ NFC card written successfully. UID: ${
          data.uid || "unknown"
        }`
      );

      /*
       * Refresh Local Agent status.
       */

      await checkLocalAgent();

    } catch (error) {

      console.error(
        "Local NFC write error:",
        error
      );

      setMessage(
        `❌ ${
          error instanceof Error
            ? error.message
            : "Failed to write NFC card."
        }`
      );

    } finally {
      setWriting(false);
    }
  };

  // ---------------------------------------------------------
  // Write using Mobile Web NFC
  // ---------------------------------------------------------

  const writeWithWebNfc = async () => {

    if (!profileUrl) {
      setMessage(
        "❌ NFC URL is not ready yet."
      );
      return;
    }

    setWriting(true);
    setMessage("");

    try {

      // @ts-ignore
      const ndef = new NDEFReader();

      await ndef.write({
        records: [
          {
            recordType: "url",
            data: profileUrl,
          },
        ],
      });

      setMessage(
        "✅ NFC card written successfully!"
      );

    } catch (error) {

      console.error(
        "Web NFC write error:",
        error
      );

      setMessage(
        "❌ Failed to write NFC card."
      );

    } finally {
      setWriting(false);
    }
  };

  // ---------------------------------------------------------
  // Main Write Button
  // ---------------------------------------------------------

  const writeNFC = async () => {

    /*
     * If Web NFC is available, preserve the
     * existing mobile behavior.
     */

    if (webNfcSupported) {
      await writeWithWebNfc();
      return;
    }

    /*
     * Otherwise use Windows + ACR122U.
     */

    await writeWithLocalAgent();
  };

  // ---------------------------------------------------------
  // Copy URL
  // ---------------------------------------------------------

  const copyUrl = async () => {

    try {

      await navigator.clipboard.writeText(
        profileUrl
      );

      setMessage(
        "✅ NFC URL copied!"
      );

    } catch {

      setMessage(
        "❌ Failed to copy URL."
      );
    }
  };

  // ---------------------------------------------------------
  // Determine desktop reader availability
  // ---------------------------------------------------------

  const localReaderAvailable =
    Boolean(
      agentStatus?.success &&
      agentStatus?.reader_connected
    );

  // ---------------------------------------------------------
  // Render
  // ---------------------------------------------------------

  return (
    <main className="min-h-screen bg-black text-white p-4 md:p-8">

      <div className="max-w-4xl mx-auto">

        {/* Header */}

        <div className="mb-10">

          <h1 className="text-4xl md:text-5xl font-bold mb-4">
            NFC Tools
          </h1>

          <p className="text-gray-400 text-lg">
            Write your digital profile directly to NFC
            cards and tags.
          </p>

        </div>

        {/* NFC Compatibility */}

        <div className="bg-[#081028] border border-white/10 rounded-3xl p-8 mb-8">

          <h2 className="text-2xl font-bold mb-6">
            NFC Compatibility
          </h2>

          {/* Mobile */}

          <div className="mb-6">

            <h3 className="font-semibold text-lg mb-2">
              📱 Mobile NFC
            </h3>

            {webNfcSupported ? (

              <p className="text-green-400">
                ✅ Web NFC is supported.
              </p>

            ) : (

              <p className="text-gray-400">
                Web NFC is not available in this
                browser.
              </p>

            )}

          </div>

          {/* Windows */}

          <div>

            <h3 className="font-semibold text-lg mb-2">
              🖥️ Windows NFC Reader
            </h3>

            {localReaderAvailable ? (

              <div>

                <p className="text-green-400">
                  ✅ NFC Local Agent connected.
                </p>

                <p className="text-gray-400 mt-1">
                  Reader:{" "}
                  {agentStatus?.reader}
                </p>

                <p className="text-gray-500 text-sm mt-1">
                  Agent version:{" "}
                  {agentStatus?.version}
                </p>

              </div>

            ) : (

              <p className="text-gray-400">
                ACR122U Local Agent is not
                currently available.
              </p>

            )}

            <button
              onClick={checkLocalAgent}
              disabled={checkingAgent}
              className="mt-4 bg-white/10 hover:bg-white/20 disabled:opacity-50 transition px-5 py-2 rounded-xl"
            >
              {checkingAgent
                ? "Checking..."
                : "Check NFC Reader"}
            </button>

          </div>

        </div>

        {/* NFC Writer */}

        <div className="bg-[#081028] border border-white/10 rounded-3xl p-8">

          <h2 className="text-3xl font-bold mb-4">
            Write NFC Card
          </h2>

          <p className="text-gray-400 mb-6">
            Use your phone NFC when Web NFC is
            available, or use the ACR122U reader
            on Windows.
          </p>

          {/* NFC URL */}

          <div className="bg-black border border-white/10 rounded-2xl p-4 mb-6 break-all text-sm text-gray-300">

            {profileUrl ||
              "Generating NFC token..."}

          </div>

          {/* Buttons */}

          <div className="flex flex-wrap gap-4">

            <button
              onClick={writeNFC}
              disabled={
                writing ||
                !profileUrl ||
                (
                  !webNfcSupported &&
                  !localReaderAvailable
                )
              }
              className="bg-blue-600 hover:bg-blue-700 disabled:opacity-50 transition px-8 py-4 rounded-2xl font-semibold text-lg"
            >

              {writing
                ? "Writing NFC..."
                : webNfcSupported
                ? "Write NFC Card"
                : "Write NFC Card with ACR122U"}

            </button>

            <button
              onClick={copyUrl}
              disabled={!profileUrl}
              className="bg-white/10 hover:bg-white/20 disabled:opacity-50 transition px-8 py-4 rounded-2xl font-semibold text-lg"
            >

              Copy NFC URL

            </button>

          </div>

          {/* Method information */}

          <div className="mt-6 text-sm text-gray-500">

            {webNfcSupported ? (

              <p>
                📱 Writing method: Mobile Web NFC
              </p>

            ) : localReaderAvailable ? (

              <p>
                🖥️ Writing method: ACR122U Local
                Agent
              </p>

            ) : (

              <p>
                Connect an ACR122U reader or use a
                browser with Web NFC support.
              </p>

            )}

          </div>

          {/* Message */}

          {message && (

            <div className="mt-6 text-lg">

              {message}

            </div>

          )}

        </div>

      </div>

    </main>
  );
}